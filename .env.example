# Copy to .env.local for local development. Never commit real values.
# Safe-to-expose browser variables (the publishable/anon key is protected by RLS):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side secrets: set ONLY as Supabase Edge Function secrets, never in Vercel client env or git:
#   SUPABASE_SERVICE_ROLE_KEY   (injected automatically by Supabase into Edge Functions)
#   SUPABASE_URL                (injected automatically by Supabase into Edge Functions)
#   PROVIDER_SECRET_<PROVIDER>  (one shared HMAC secret per provider, e.g. PROVIDER_SECRET_ACME)
